{
  "name": "linkos",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first, plugin-native collaboration workspace.",
  "packageManager": "pnpm@9.15.5",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs dev",
    "setup:dev": "node scripts/dev.mjs setup",
    "doctor": "node scripts/dev.mjs doctor",
    "dev:status": "node scripts/dev.mjs status",
    "dev:acceptance": "node scripts/dev.mjs dev --acceptance",
    "setup:acceptance": "node scripts/dev.mjs setup --acceptance",
    "release": "node scripts/release.mjs",
    "test:launcher": "node --test scripts/dev-support.test.mjs",
    "plugin:pack": "node scripts/plugin-package.mjs pack",
    "plugin:keygen": "node scripts/plugin-package.mjs keygen",
    "test:plugins": "node scripts/smoke-plugins.mjs",
    "build": "pnpm --filter @linkos/web build",
    "typecheck": "pnpm --filter @linkos/web typecheck",
    "test:go": "go test ./services/gateway/... ./services/runner/...",
    "test:web": "pnpm --filter @linkos/web test:web",
    "test:e2e": "pnpm --filter @linkos/web test:e2e"
  },
  "devDependencies": {
    "prettier": "^3.5.3"
  }
}
