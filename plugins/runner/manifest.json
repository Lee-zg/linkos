{
  "id": "runner.exec",
  "name": "运行任务",
  "version": "0.1.0",
  "apiVersion": "1.0",
  "entry": {
    "ui": "ui/index.js",
    "service": "service/index.js",
    "runner": "runner/index.js"
  },
  "contributes": {
    "routes": ["/tasks"],
    "commands": ["job.submit", "job.cancel"],
    "resourceTypes": ["job"],
    "messageBlocks": ["run.result"]
  },
  "permissions": ["job.submit", "job.cancel", "runner.read"],
  "network": { "mode": "deny" },
  "runner": { "required": true }
}
